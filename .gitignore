# PlatformIO build output and IDE files
.pio/
firmware/.pio/
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# PyInstaller output
bridge/build/
bridge/dist/
bridge/package/
bridge/*.spec
bridge/*.zip

# Local settings (may contain machine-specific ports)
bridge/config.ini
.env

# Logs and editor/OS clutter
*.log
*.swp
*~
.DS_Store
Thumbs.db

# Firmware backups and dumps are large and board-specific; keep them out of the repo
*.bin
